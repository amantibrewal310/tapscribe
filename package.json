{
  "name": "tapscribe",
  "displayName": "TapScribe",
  "description": "Write mobile UI tests in plain English or record them by tapping the emulator screen, with live device video and logcat side by side.",
  "version": "0.3.0",
  "publisher": "amantibrewal310",
  "license": "MIT",
  "author": {
    "name": "Aman Tibrewal"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amantibrewal310/tapscribe.git"
  },
  "bugs": {
    "url": "https://github.com/amantibrewal310/tapscribe/issues"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#161a2e",
    "theme": "dark"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "android",
    "adb",
    "emulator",
    "mobile testing",
    "ui testing",
    "test recorder",
    "logcat",
    "automation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tapscribe.openTestLab",
        "category": "TapScribe",
        "title": "Open Test Lab"
      }
    ],
    "languages": [
      {
        "id": "tapscribe",
        "aliases": [
          "TapScribe Script"
        ],
        "extensions": [
          ".taps"
        ],
        "configuration": "./language/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tapscribe",
        "scopeName": "source.tapscribe",
        "path": "./language/tapscribe.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TapScribe",
      "properties": {
        "tapscribe.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "Path to the adb executable. Leave as \"adb\" when it is on PATH."
        },
        "tapscribe.screenRefreshMs": {
          "type": "number",
          "default": 400,
          "minimum": 150,
          "description": "Delay between screen captures, in milliseconds, measured from the end of the previous capture. Lower is smoother but works adb harder."
        },
        "tapscribe.logBufferLines": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "description": "Maximum number of logcat lines kept in the log panel."
        },
        "tapscribe.screenMode": {
          "type": "string",
          "enum": [
            "auto",
            "video",
            "screenshots"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Video when the device and editor support it, otherwise screenshots.",
            "Always stream H.264 video via screenrecord.",
            "Always poll screenshots via screencap."
          ],
          "description": "How the device screen is mirrored."
        },
        "tapscribe.videoBitrateMbps": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "description": "Bitrate for the H.264 video stream, in megabits per second."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3"
  }
}
