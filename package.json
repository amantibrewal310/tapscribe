{
  "name": "tapscribe",
  "displayName": "TapScribe",
  "description": "Write mobile UI tests in plain English or record them by tapping the emulator screen, with live device video and logcat side by side.",
  "version": "0.1.0",
  "publisher": "amantibrewal",
  "license": "MIT",
  "author": {
    "name": "Aman Tibrewal"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amantibrewal310/app-testing-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/amantibrewal310/app-testing-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tapscribe.openTestLab",
        "category": "TapScribe",
        "title": "Open Test Lab"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.98.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
